diff --git a/src/discounts.py b/src/discounts.py
new file mode 100644
index 0000000..5d1e7aa
--- /dev/null
+++ b/src/discounts.py
@@ -0,0 +1,12 @@
+from decimal import Decimal
+
+
+def best_discount(cart, customer):
+    """The biggest discount the customer can get on this cart."""
+    offers = [Decimal(0)]
+    if customer.is_member:
+        offers.append(cart.subtotal * Decimal("0.10"))
+    if len(cart.items) >= 5:
+        offers.append(Decimal("5.00"))
+    return max(offers)
+
